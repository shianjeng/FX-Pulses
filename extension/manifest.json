{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "2.8.2",
  "default_locale": "zh_CN",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "clipboardWrite", "scripting", "alarms"],
  "optional_permissions": ["notifications"],
  "background": {"service_worker": "background.js"},
  "web_accessible_resources": [{"resources": ["icons/icon.svg"], "matches": ["https://*/*", "http://*/*"], "use_dynamic_url": true}],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "host_permissions": ["https://shianjeng.github.io/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
    "default_title": "FX Pulse",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
