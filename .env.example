# App
DATABASE_URL=sqlite:///./fx_pulse.db

# Production uses Alpha Vantage. Set FX_PROVIDER=mock explicitly for demo only.
FX_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=
TRACKED_PAIRS=USD/CNY,USD/JPY,CNY/JPY
# Official reference sources. "pboc" reads a website data endpoint rather than a
# documented API; verify all configured sources with `python -m app.check_official`.
OFFICIAL_SOURCES=ecb,bank_of_canada,federal_reserve,bank_of_japan,pboc
# 240 stays within the usual free quota for 3 pairs; lower it with a higher-quota key.
REFRESH_INTERVAL_MINUTES=240
STALE_AFTER_MINUTES=360

# Read limiting and caching
# RESPONSE_CACHE_SECONDS=60
# TRUST_FORWARDED_FOR=false   # set true only behind your own reverse proxy

# Compose only: override before exposing the stack anywhere.
# POSTGRES_PASSWORD=change-me
