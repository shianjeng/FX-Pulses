# App
DATABASE_URL=sqlite:///./fx_pulse.db

# "mock" works immediately; "alpha_vantage" uses live bid/ask quotes.
FX_PROVIDER=mock
ALPHA_VANTAGE_API_KEY=
TRACKED_PAIRS=USD/CNY,USD/JPY,CNY/JPY
# 240 stays within the usual free quota for 3 pairs; lower it with a higher-quota key.
REFRESH_INTERVAL_MINUTES=240
STALE_AFTER_MINUTES=360
