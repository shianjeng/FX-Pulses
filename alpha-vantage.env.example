# Alpha Vantage free-plan profile: 3 pairs x 6 refreshes/day = 18 requests/day.
# Copy this file to .env, then replace the placeholder with your own key.
DATABASE_URL=sqlite:///./fx_pulse.db
FX_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=replace_with_your_own_key
TRACKED_PAIRS=USD/CNY,USD/JPY,CNY/JPY
REFRESH_INTERVAL_MINUTES=240
# Space pair requests to avoid burst throttling on free keys.
PROVIDER_REQUEST_SPACING_SECONDS=15
PROVIDER_DAILY_BUDGET=25
STALE_AFTER_MINUTES=360
OFFICIAL_REFRESH_INTERVAL_MINUTES=360
